<!-- app/views/home/index.html.erb -->
<div class="relative bg-zinc-50 min-h-[70vh] flex flex-col justify-center items-center mt-8 overflow-hidden">
  <canvas data-controller="dot-network" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

  <div class="relative z-10 max-w-2xl text-center px-4">
    <h1 class="text-[40px] leading-[1.1] font-bold tracking-tight mb-4">
      <span class="text-zinc-400">Ne Zamaraj Se.</span> <span class="text-zinc-950">Automate your job hunt.</span>
    </h1>
    <p class="text-[15px] text-zinc-500 mb-8">
      Your personal CRM, cover letter generator, and automated job scraper for the Bosnian IT market.
    </p>

    <% if user_signed_in? %>
      <%= link_to dashboard_path, class: "inline-flex items-center gap-2 border border-emerald-200 bg-emerald-50 text-emerald-800 px-5 py-4 rounded-lg hover:bg-emerald-100 transition" do %>
        <div class="text-left">
          <p class="text-[13.5px] font-semibold">You are authenticated and ready to go.</p>
          <p class="text-[12.5px] text-emerald-700 mt-0.5">Go to your dashboard →</p>
        </div>
      <% end %>
    <% else %>
      <%= button_to "Login with Google", user_google_oauth2_omniauth_authorize_path,
            data: { turbo: false },
            class: "cursor-pointer bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] text-white text-[13.5px] font-semibold py-3 px-7 rounded-lg transition" %>
    <% end %>
  </div>
</div>
