<%# Extracted from the layout so a Turbo Stream response can render a toast
    into the existing #flash container without a page load - a board move
    refused server-side (see ApplicationsController#render_board_alert) has
    no redirect to carry its message otherwise. %>
<% if notice %>
  <div data-controller="flash"
       class="pointer-events-auto bg-white text-zinc-900 p-3.5 rounded-lg shadow-md border border-zinc-200 flex items-center justify-between transform transition-all duration-300 opacity-100 translate-y-0 dark:bg-zinc-900 dark:text-zinc-100 dark:border-zinc-800">
    <div class="flex items-center gap-2.5">
      <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <p class="text-[13px] font-medium"><%= notice %></p>
    </div>
    <button data-action="click->flash#dismiss" aria-label="<%= t("shared.hint.dismiss") %>" class="text-zinc-400 hover:text-zinc-700 transition dark:text-zinc-600 dark:hover:text-zinc-300">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
<% end %>

<% if alert %>
  <div data-controller="flash"
       class="pointer-events-auto bg-white text-red-800 p-3.5 rounded-lg shadow-md border border-red-200 flex items-center justify-between transform transition-all duration-300 opacity-100 translate-y-0 dark:bg-zinc-900 dark:text-red-300 dark:border-red-900">
    <div class="flex items-center gap-2.5">
      <svg class="w-4 h-4 text-red-500 flex-shrink-0 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
      <p class="text-[13px] font-medium"><%= alert %></p>
    </div>
    <button data-action="click->flash#dismiss" aria-label="<%= t("shared.hint.dismiss") %>" class="text-red-400 hover:text-red-700 transition dark:text-red-400 dark:hover:text-red-400">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
<% end %>
