<%
  nav_link_class = ->(path) {
    current_page?(path) ? "text-[13px] font-semibold text-zinc-950 dark:text-zinc-50" : "text-[13px] font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
  }
%>
<nav class="bg-white border-b border-zinc-200 mb-8 dark:bg-zinc-900 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2 group" do %>
          <span class="flex items-center justify-center w-5 h-5 rounded-[5px] bg-zinc-900 dark:bg-white">
            <svg class="w-3 h-3 text-white dark:text-zinc-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </span>
          <span class="text-[14.5px] font-bold text-zinc-950 tracking-tight dark:text-zinc-50">NeZamarajSe</span>
        <% end %>
      </div>

      <!-- Right side navigation -->
      <div class="flex items-center space-x-7">
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: nav_link_class.call(dashboard_path) %>
          <%= link_to "Job Market", jobs_path, class: nav_link_class.call(jobs_path) %>
          <%= link_to "Companies", companies_path, class: nav_link_class.call(companies_path) %>
          <%= link_to "My CRM", crm_path, class: nav_link_class.call(crm_path) %>
          <%= link_to "Radar Settings", edit_user_preference_path, class: nav_link_class.call(edit_user_preference_path) %>
          <%= link_to "Asset Library", resumes_path, class: nav_link_class.call(resumes_path) %>
          <%= link_to "Templates", cover_letter_templates_path, class: nav_link_class.call(cover_letter_templates_path) %>

          <div class="w-px h-4 bg-zinc-200 dark:bg-zinc-700"></div>

          <!-- Command palette trigger -->
          <button type="button" data-action="click->command-palette#open" title="Command palette" aria-label="Open command palette" class="cursor-pointer flex items-center gap-1.5 text-zinc-400 hover:text-zinc-700 dark:text-zinc-600 dark:hover:text-zinc-300 transition">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <kbd class="hidden sm:inline text-[10.5px] font-semibold border border-zinc-200 dark:border-zinc-700 rounded px-1.5 py-0.5">&#8984;K</kbd>
          </button>

          <!-- Theme toggle -->
          <button type="button" data-controller="theme" data-action="click->theme#toggle" title="Toggle dark mode" aria-label="Toggle dark mode" class="cursor-pointer text-zinc-400 hover:text-zinc-700 dark:text-zinc-600 dark:hover:text-zinc-300 transition">
            <svg data-theme-target="sunIcon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg data-theme-target="moonIcon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
          </button>

          <div class="w-px h-4 bg-zinc-200 dark:bg-zinc-700"></div>

          <span class="text-[12.5px] font-medium text-zinc-400 dark:text-zinc-600">
            <%= current_user.email %>
          </span>

          <!-- Logout Button -->
          <%= button_to "Sign out", destroy_user_session_path,
                method: :delete,
                class: "text-[13px] font-semibold text-zinc-900 hover:text-red-600 transition cursor-pointer dark:text-zinc-100 dark:hover:text-red-400" %>
        <% else %>
          <!-- Theme toggle -->
          <button type="button" data-controller="theme" data-action="click->theme#toggle" title="Toggle dark mode" aria-label="Toggle dark mode" class="cursor-pointer text-zinc-400 hover:text-zinc-700 dark:text-zinc-600 dark:hover:text-zinc-300 transition">
            <svg data-theme-target="sunIcon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg data-theme-target="moonIcon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
          </button>

          <!-- Login Link for Navbar -->
          <%= button_to "Sign in", user_google_oauth2_omniauth_authorize_path,
                data: { turbo: false },
                class: "text-[13px] font-semibold text-zinc-900 hover:text-zinc-600 transition cursor-pointer dark:text-zinc-100 dark:hover:text-zinc-400" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>