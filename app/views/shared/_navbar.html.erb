<%
  nav_link_class = ->(path) {
    current_page?(path) ? "text-[13px] font-semibold text-zinc-950" : "text-[13px] font-medium text-zinc-500 hover:text-zinc-900"
  }
%>
<nav class="bg-white border-b border-zinc-200 mb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2 group" do %>
          <span class="flex items-center justify-center w-5 h-5 rounded-[5px] bg-zinc-900">
            <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </span>
          <span class="text-[14.5px] font-bold text-zinc-950 tracking-tight">NeZamarajSe</span>
        <% end %>
      </div>

      <!-- Right side navigation -->
      <div class="flex items-center space-x-7">
        <% if user_signed_in? %>
          <%= link_to "Job Market", jobs_path, class: nav_link_class.call(jobs_path) %>
          <%= link_to "My CRM", crm_path, class: nav_link_class.call(crm_path) %>
          <%= link_to "Radar Settings", edit_user_preference_path, class: nav_link_class.call(edit_user_preference_path) %>
          <%= link_to "Asset Library", resumes_path, class: nav_link_class.call(resumes_path) %>
          <%= link_to "Templates", cover_letter_templates_path, class: nav_link_class.call(cover_letter_templates_path) %>

          <div class="w-px h-4 bg-zinc-200"></div>

          <span class="text-[12.5px] font-medium text-zinc-400">
            <%= current_user.email %>
          </span>

          <!-- Logout Button -->
          <%= button_to "Sign out", destroy_user_session_path,
                method: :delete,
                class: "text-[13px] font-semibold text-zinc-900 hover:text-red-600 transition cursor-pointer" %>
        <% else %>
          <!-- Login Link for Navbar -->
          <%= button_to "Sign in", user_google_oauth2_omniauth_authorize_path,
                data: { turbo: false },
                class: "text-[13px] font-semibold text-zinc-900 hover:text-zinc-600 transition cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>