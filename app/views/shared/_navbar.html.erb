<nav class="bg-white shadow mb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <%= link_to "NeZamarajSe", root_path, class: "text-2xl font-black text-indigo-600 tracking-tighter" %>
      </div>

      <!-- Right side navigation -->
      <div class="flex items-center space-x-6">
        <% if user_signed_in? %>
          <span class="text-sm font-medium text-gray-500">
            <%= current_user.email %>
          </span>
          
          <!-- Logout Button -->
          <%= button_to "Sign out", destroy_user_session_path, 
                method: :delete, 
                class: "text-sm font-bold text-red-600 hover:text-red-800 transition" %>
        <% else %>
          <!-- Login Link for Navbar -->
          <%= button_to "Sign in", user_google_oauth2_omniauth_authorize_path, 
                data: { turbo: false }, 
                class: "text-sm font-bold text-indigo-600 hover:text-indigo-800 transition" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>