<!-- app/views/shared/_notification_badge.html.erb -->
<span id="notification_badge">
  <% if count.positive? %>
    <span class="absolute -top-1 -right-1.5 flex items-center justify-center min-w-[15px] h-[15px] px-1 rounded-full bg-red-500 text-white text-[9.5px] font-bold leading-none">
      <%= count > 9 ? "9+" : count %>
    </span>
  <% end %>
</span>
