<%# app/views/shared/_pagination.html.erb
    Expects a local `pagy` (a Pagy instance). Hand-rolled rather than using
    Pagy's own pagy_nav helper, to match the rest of the app's plain
    Tailwind-zinc styling instead of Pagy's own default markup/classes. %>
<% if pagy.pages > 1 %>
  <nav class="flex flex-wrap items-center justify-between gap-3 mt-8 text-[13px]" aria-label="Pagination">
    <%# Rails' own t(), not Pagy's pagy_info - Pagy ships no Bosnian
        locale, and this is the only string it would be needed for. %>
    <p class="text-zinc-500 dark:text-zinc-400"><%= t("shared.pagination.info", from: pagy.from, to: pagy.to, count: pagy.count) %></p>

    <%# overflow-x-auto is the fallback for a page count wide enough that
        even a full mobile-width row can't fit every link - degrades to a
        horizontally scrollable strip instead of forcing the whole page
        wider, matching the Kanban board's own overflow-x-auto columns. %>
    <div class="flex items-center gap-1 max-w-full overflow-x-auto">
      <% if pagy.prev %>
        <%= link_to t("shared.pagination.prev"), url_for(request.query_parameters.merge(page: pagy.prev)), class: "px-3 py-1.5 rounded-md font-semibold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-800" %>
      <% else %>
        <span class="px-3 py-1.5 rounded-md font-semibold text-zinc-300 cursor-not-allowed dark:text-zinc-700"><%= t("shared.pagination.prev") %></span>
      <% end %>

      <% pagy.series.each do |item| %>
        <% if item == :gap %>
          <span class="px-2 text-zinc-400 dark:text-zinc-600">&hellip;</span>
        <% elsif item.is_a?(String) %>
          <span class="px-3 py-1.5 rounded-md font-bold text-white bg-zinc-900 dark:text-zinc-900 dark:bg-white"><%= item %></span>
        <% else %>
          <%= link_to item, url_for(request.query_parameters.merge(page: item)), class: "px-3 py-1.5 rounded-md font-semibold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-800" %>
        <% end %>
      <% end %>

      <% if pagy.next %>
        <%= link_to t("shared.pagination.next"), url_for(request.query_parameters.merge(page: pagy.next)), class: "px-3 py-1.5 rounded-md font-semibold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-800" %>
      <% else %>
        <span class="px-3 py-1.5 rounded-md font-semibold text-zinc-300 cursor-not-allowed dark:text-zinc-700"><%= t("shared.pagination.next") %></span>
      <% end %>
    </div>
  </nav>
<% end %>
