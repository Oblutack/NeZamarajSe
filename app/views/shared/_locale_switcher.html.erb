<div class="flex items-center text-[11px] font-bold border border-zinc-200 dark:border-zinc-700 rounded-md overflow-hidden">
  <%= link_to "EN", set_locale_path(locale: "en"), data: { turbo: false }, class: "px-2 py-1 transition #{I18n.locale == :en ? "bg-zinc-900 text-white dark:bg-white dark:text-zinc-900" : "text-zinc-400 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100"}" %>
  <%= link_to "BS", set_locale_path(locale: "bs"), data: { turbo: false }, class: "px-2 py-1 transition #{I18n.locale == :bs ? "bg-zinc-900 text-white dark:bg-white dark:text-zinc-900" : "text-zinc-400 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100"}" %>
</div>
