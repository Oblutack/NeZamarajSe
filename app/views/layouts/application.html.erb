<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ne Zamaraj Se" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ne Zamaraj Se">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Sets the `dark` class on <html> before first paint, so there's no
        flash of the wrong theme. Must be a plain inline script (not an
        importmap-loaded Stimulus controller, which only runs after Turbo
        has already rendered the page) and must run on every full document
        load - Turbo Drive keeps <html> as-is across same-tab navigations,
        so the class persists on its own after this first runs; it only
        needs to fire again on an actual fresh load. See theme_controller.js
        for the toggle button that flips this after load. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        var theme = localStorage.getItem("theme");
        if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap">

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="relative" data-controller="<%= 'command-palette keyboard-shortcuts' if user_signed_in? %>">
    <%= render "shared/command_palette" if user_signed_in? %>
    <%= render "shared/confirm_dialog" if user_signed_in? %>

    <!-- Full-bleed page canvas: a plain descendant (not <body> itself, which
         would propagate its background to the root and break normal
         stacking - see application.css) sized to the full document via
         position:relative on <body> + inset-0 here, not to <main>, which
         Tailwind's `container` class caps at a max-width well short of the
         viewport on larger screens. -->
    <div class="absolute inset-0 -z-10 page-canvas" aria-hidden="true"></div>

    <!-- 1. Render the Navbar at the very top -->
    <%= render "shared/navbar" %>

    <!-- FLOATING TOAST CONTAINER -->
    <div class="fixed top-5 right-5 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none">
      <% if notice %>
        <div data-controller="flash"
             class="pointer-events-auto bg-white text-zinc-900 p-3.5 rounded-lg shadow-md border border-zinc-200 flex items-center justify-between transform transition-all duration-300 opacity-100 translate-y-0 dark:bg-zinc-900 dark:text-zinc-100 dark:border-zinc-800">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <p class="text-[13px] font-medium"><%= notice %></p>
          </div>
          <button data-action="click->flash#dismiss" aria-label="<%= t("shared.hint.dismiss") %>" class="text-zinc-400 hover:text-zinc-700 transition dark:text-zinc-600 dark:hover:text-zinc-300">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      <% end %>

      <% if alert %>
        <div data-controller="flash"
             class="pointer-events-auto bg-white text-red-800 p-3.5 rounded-lg shadow-md border border-red-200 flex items-center justify-between transform transition-all duration-300 opacity-100 translate-y-0 dark:bg-zinc-900 dark:text-red-300 dark:border-red-900">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-red-500 flex-shrink-0 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
            <p class="text-[13px] font-medium"><%= alert %></p>
          </div>
          <button data-action="click->flash#dismiss" aria-label="<%= t("shared.hint.dismiss") %>" class="text-red-400 hover:text-red-700 transition dark:text-red-400 dark:hover:text-red-400">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      <% end %>
    </div>
    <!-- END FLOATING TOAST CONTAINER -->

    <%# Pages that want to break out of the centered `container` column (the
        home hero, which runs edge to edge) override this via
        `content_for :main_class`. The default min-height subtracts the
        navbar (65px) plus its 32px margin so a short page fills exactly
        one viewport instead of forcing ~97px of pointless scroll. %>
    <main class="<%= content_for(:main_class).presence || "container mx-auto px-5 flex flex-col min-h-[calc(100vh-97px)]" %>">
      <%= yield %>
    </main>
  </body>
</html>
