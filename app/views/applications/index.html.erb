<!-- app/views/applications/index.html.erb -->

<%= turbo_stream_from current_user, :crm %>

<!-- 1. Wrap the entire board in a form and attach our Stimulus controller -->
<%= form_with url: bulk_compose_applications_path, method: :get, data: { controller: "bulk-campaign" }, class: "relative max-w-screen-2xl mx-auto py-8 overflow-hidden flex flex-col h-[85vh]" do |form| %>

  <%= render "shared/dot_pattern_band" %>

  <div class="relative mb-2 px-4 sm:px-6 lg:px-8 flex justify-between items-center">
    <div>
      <h2 class="text-[22px] font-bold text-zinc-950 tracking-tight">My CRM</h2>
      <p class="text-[13.5px] text-zinc-500 mt-1">Drag and drop jobs to track your application pipeline.</p>
    </div>
  </div>

  <div class="relative flex-1 overflow-x-auto flex px-4 sm:px-6 lg:px-8 pb-4 border-t border-zinc-100">
    <% @grouped_applications.each do |status, applications| %>
      <div class="flex-shrink-0 w-72 flex flex-col border-r border-zinc-100 last:border-r-0" data-controller="drag" data-action="dragover->drag#dragOver drop->drag#drop" data-status="<%= status %>">

        <div class="pt-3.5 pb-3 pr-4">
          <h3 class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide flex justify-between items-center">
            <%= status.titleize %>
            <span class="text-zinc-400 font-semibold"><%= applications.count %></span>
          </h3>
        </div>

        <div class="flex-1 pr-3 overflow-y-auto space-y-2.5">
          <% if applications.any? %>
            <% applications.each do |app| %>
              <%= render "applications/application_card", app: app %>
            <% end %>
          <% else %>
            <div class="flex flex-col items-center text-center py-8 px-3 border border-dashed border-zinc-200 rounded-lg">
              <svg class="w-6 h-6 text-zinc-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0l-2.586 2.586a2 2 0 01-1.414.586H10a2 2 0 01-1.414-.586L6 13m14 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5"></path>
              </svg>
              <% if status == "wishlist" %>
                <p class="mt-2.5 text-[12px] text-zinc-500">Save jobs from the</p>
                <%= link_to "Job Market", jobs_path, class: "text-[12px] font-semibold text-zinc-700 hover:text-zinc-950" %>
                <p class="text-[12px] text-zinc-500">to get started.</p>
              <% else %>
                <p class="mt-2.5 text-[12px] text-zinc-500">Nothing here yet.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 3. The Floating "Bulk Apply" Bar -->
  <div data-bulk-campaign-target="floatingBar" class="fixed bottom-0 left-0 right-0 bg-zinc-900 text-white shadow-2xl p-4 transform translate-y-full transition-transform duration-300 z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center px-4">
      <div class="flex items-center space-x-4">
        <span class="bg-zinc-700 text-white font-bold h-8 w-8 rounded-full flex items-center justify-center" data-bulk-campaign-target="countBadge">0</span>
        <span class="font-medium text-lg">Jobs selected for Bulk Campaign</span>
      </div>
      <!-- This button submits the form! -->
      <button type="submit" class="bg-white text-zinc-900 px-6 py-2.5 rounded-lg font-bold hover:bg-zinc-100 active:scale-[0.98] transition shadow">
        Prepare Campaign
      </button>
    </div>
  </div>

<% end %>

<!-- Hidden Drag-and-Drop Form (Outside the main form so they don't conflict!) -->
<% current_user.applications.each do |app| %>
  <%= form_with model: app, id: "move-form-#{app.id}", class: "hidden" do |f| %>
    <%= f.hidden_field :status, class: "status-input" %>
  <% end %>
<% end %>