<!-- app/views/applications/index.html.erb -->

<%= turbo_stream_from current_user, :crm %>

<!-- 1. Wrap the entire board in a form and attach our Stimulus controller -->
<%= form_with url: bulk_compose_applications_path, method: :get, data: { controller: "bulk-campaign" }, class: "max-w-screen-2xl mx-auto py-8 overflow-hidden flex flex-col h-[85vh]" do |form| %>

  <div class="mb-6 px-4 sm:px-6 lg:px-8 flex justify-between items-center">
    <div>
      <h2 class="text-3xl font-extrabold text-gray-900">My CRM</h2>
      <p class="text-sm text-gray-500 mt-1">Drag and drop jobs to track your application pipeline.</p>
    </div>
  </div>

  <div class="flex-1 overflow-x-auto flex space-x-6 px-4 sm:px-6 lg:px-8 pb-4">
    <% @grouped_applications.each do |status, applications| %>
      <div class="flex-shrink-0 w-80 bg-gray-100 rounded-xl flex flex-col" data-controller="drag" data-action="dragover->drag#dragOver drop->drag#drop" data-status="<%= status %>">
        
        <div class="p-4 border-b border-gray-200">
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider flex justify-between">
            <%= status.titleize %>
            <span class="bg-gray-200 text-gray-600 py-0.5 px-2 rounded-full text-xs"><%= applications.count %></span>
          </h3>
        </div>

        <div class="flex-1 p-3 overflow-y-auto space-y-3">
          <% applications.each do |app| %>
            <%= render "applications/application_card", app: app %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 3. The Floating "Bulk Apply" Bar -->
  <div data-bulk-campaign-target="floatingBar" class="fixed bottom-0 left-0 right-0 bg-indigo-900 text-white shadow-2xl p-4 transform translate-y-full transition-transform duration-300 z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center px-4">
      <div class="flex items-center space-x-4">
        <span class="bg-indigo-700 text-white font-bold h-8 w-8 rounded-full flex items-center justify-center" data-bulk-campaign-target="countBadge">0</span>
        <span class="font-medium text-lg">Jobs selected for Bulk Campaign</span>
      </div>
      <!-- This button submits the form! -->
      <button type="submit" class="bg-white text-indigo-900 px-6 py-2 rounded-lg font-bold hover:bg-indigo-50 transition shadow">
        Prepare Campaign
      </button>
    </div>
  </div>

<% end %>

<!-- Hidden Drag-and-Drop Form (Outside the main form so they don't conflict!) -->
<% current_user.applications.each do |app| %>
  <%= form_with model: app, id: "move-form-#{app.id}", class: "hidden" do |f| %>
    <%= f.hidden_field :status, class: "status-input" %>
  <% end %>
<% end %>