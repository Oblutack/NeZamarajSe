<!-- app/views/applications/compose.html.erb -->
<div class="max-w-2xl mx-auto py-12">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Prepare Application</h1>
  <p class="text-gray-500 mb-8">You are applying for <span class="font-bold text-indigo-600"><%= @application.job.title %></span> at <%= @application.job.company.name %>.</p>

  <div class="bg-white shadow sm:rounded-lg p-6">
    <%= form_with url: dispatch_email_application_path(@application), method: :post, class: "space-y-6" do |f| %>
      
      <!-- Template Dropdown -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Select Cover Letter Template</label>
        <%= f.collection_select :template_id, @templates, :id, :name, { prompt: "Choose a template..." }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" } %>
      </div>

      <!-- Resume Dropdown -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Select CV / Resume</label>
        <!-- ActiveStorage uses blob.id uniquely identify the file -->
        <%= f.collection_select :resume_blob_id, @resumes, ->(r) { r.blob.id }, ->(r) { r.filename.to_s }, { prompt: "Choose a resume..." }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" } %>
      </div>

      <div class="flex justify-end pt-4 border-t border-gray-200">
        <%= link_to "Cancel", crm_path, class: "mr-3 bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50" %>
        <%= f.submit "Send Email via Gmail", class: "cursor-pointer inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>