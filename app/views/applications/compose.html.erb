<!-- app/views/applications/compose.html.erb -->
<div class="max-w-2xl mx-auto py-8">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-1.5">Prepare Application</h1>
  <p class="text-[13.5px] text-zinc-500 mb-6">You are applying for <span class="font-semibold text-indigo-700"><%= @application.job.title %></span> at <%= @application.job.company.name %>.</p>

  <div class="bg-white border border-zinc-200 rounded-lg p-6">
    <%= form_with url: dispatch_email_application_path(@application), method: :post, class: "space-y-5" do |f| %>

      <!-- Template Dropdown -->
      <div>
        <label class="block text-[13px] font-semibold text-zinc-700">Select Cover Letter Template</label>
        <%= f.collection_select :template_id, @templates, :id, :name, { prompt: "Choose a template..." }, { class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" } %>
      </div>

      <!-- Resume Dropdown -->
      <div>
        <label class="block text-[13px] font-semibold text-zinc-700">Select CV / Resume</label>
        <!-- ActiveStorage uses blob.id uniquely identify the file -->
        <%= f.collection_select :resume_blob_id, @resumes, ->(r) { r.blob.id }, ->(r) { r.filename.to_s }, { prompt: "Choose a resume..." }, { class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" } %>
      </div>

      <div class="flex justify-end pt-4 border-t border-zinc-100">
        <%= link_to "Cancel", crm_path, class: "mr-3 bg-white py-2 px-4 border border-zinc-300 rounded-md text-[13px] font-semibold text-zinc-700 hover:bg-zinc-50" %>
        <%= f.submit "Send Email via Gmail", class: "cursor-pointer inline-flex justify-center py-2 px-4 text-[13px] font-semibold rounded-md text-white bg-indigo-700 hover:bg-indigo-800 active:scale-[0.98]" %>
      </div>
    <% end %>
  </div>
</div>
