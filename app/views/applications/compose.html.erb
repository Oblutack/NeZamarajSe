<!-- app/views/applications/compose.html.erb -->
<div class="max-w-2xl w-full mx-auto py-8">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-1.5 dark:text-zinc-50"><%= t(".title") %></h1>
  <p class="text-[13.5px] text-zinc-500 mb-6 dark:text-zinc-400"><%= t(".applying_for") %> <span class="font-semibold text-zinc-900 dark:text-zinc-100"><%= @application.job.title %></span> <%= t(".at") %> <%= @application.job.company.name %>.</p>

  <%= render "shared/hint", id: "compose_explainer", title: t("shared.compose.explainer_title"), text: t("shared.compose.explainer_body") %>

  <% if Rails.application.config.dry_run_emails %>
    <div class="mb-5 border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 rounded-lg text-[13px] dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-400">
      <span class="font-semibold"><%= t("shared.compose.dry_run_title") %></span> <%= t("shared.compose.dry_run_body", email: current_user.email) %>
    </div>
  <% end %>

  <turbo-frame id="compose_preview" class="block space-y-5">
    <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
      <%= form_with url: compose_application_path(@application), method: :get, data: { turbo_frame: "compose_preview" }, class: "space-y-5" do %>
        <!-- Template Dropdown -->
        <div>
          <label class="block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300"><%= t("shared.compose.select_template") %></label>
          <%= select_tag :template_id,
                options_from_collection_for_select(@templates, :id, :name, @selected_template&.id),
                include_blank: t("shared.compose.choose_template"),
                data: { controller: "auto-submit", action: "change->auto-submit#submit" },
                class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
        </div>

        <!-- Resume Dropdown -->
        <div>
          <label class="block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300"><%= t("shared.compose.select_resume") %></label>
          <!-- ActiveStorage uses blob.id to uniquely identify the file -->
          <%= select_tag :resume_blob_id,
                options_for_select(@resumes.map { |r| [ r.filename.to_s, r.blob.id ] }, @selected_resume&.blob&.id),
                include_blank: t("shared.compose.choose_resume"),
                data: { controller: "auto-submit", action: "change->auto-submit#submit" },
                class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
        </div>
      <% end %>
    </div>

    <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
      <h2 class="text-[13px] font-semibold text-zinc-700 mb-1 dark:text-zinc-300"><%= t(".ai_generate_title") %></h2>
      <p class="text-[12.5px] text-zinc-500 mb-3 dark:text-zinc-400"><%= t(".ai_generate_hint") %></p>

      <%= form_with url: generate_cover_letter_application_path(@application), method: :post, data: { turbo_frame: "_top" }, class: "grid grid-cols-1 gap-3 sm:flex sm:flex-wrap sm:items-end" do %>
        <%= hidden_field_tag :resume_blob_id, @selected_resume&.blob&.id %>
        <div class="min-w-0">
          <label class="block text-[11.5px] font-medium text-zinc-500 dark:text-zinc-400"><%= t("shared.ai_cover_letter.language") %></label>
          <%= select_tag :language, options_for_select(CoverLetterTemplate::LANGUAGES.map { |code, _| [ t("shared.ai_cover_letter.#{code == 'en' ? 'english' : 'bosnian'}"), code ] }, "en"), class: "w-full sm:w-auto mt-1 rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
        </div>
        <%= button_tag type: "submit", disabled: @selected_resume.nil?, class: "cursor-pointer inline-flex items-center justify-center gap-1.5 px-4 py-2 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" do %>
          <%= render "shared/sparkle_icon", class: "w-3.5 h-3.5" %>
          <%= t("shared.ai_cover_letter.generate") %>
        <% end %>
      <% end %>
      <% if @selected_resume.nil? %>
        <p class="text-[11.5px] text-amber-700 mt-2 dark:text-amber-400"><%= t("shared.ai_cover_letter.pick_resume_first") %></p>
      <% end %>
    </div>

    <% if @selected_template && @selected_resume %>
      <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
        <h2 class="text-[13px] font-semibold text-zinc-700 mb-3 dark:text-zinc-300"><%= t("shared.compose.preview_title") %></h2>

        <dl class="space-y-3 text-[13px]">
          <div>
            <dt class="text-zinc-500 dark:text-zinc-400"><%= t("shared.compose.to") %></dt>
            <% if @application.intended_recipient.present? %>
              <dd class="font-medium text-zinc-900 mt-0.5 dark:text-zinc-100"><%= @application.intended_recipient %></dd>
            <% else %>
              <dd class="mt-0.5 inline-flex items-center gap-1.5 font-medium text-red-700 dark:text-red-400">
                <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
                <%= t("shared.compose.no_email_found") %>
              </dd>
            <% end %>
          </div>
          <div>
            <dt class="text-zinc-500 dark:text-zinc-400"><%= t("shared.compose.subject") %></dt>
            <dd class="font-medium text-zinc-900 mt-0.5 dark:text-zinc-100"><%= JobApplicationMailer.subject_for(@application.job) %></dd>
          </div>
          <div>
            <dt class="text-zinc-500 dark:text-zinc-400"><%= t("shared.compose.attachment") %></dt>
            <dd class="font-medium text-zinc-900 mt-0.5 dark:text-zinc-100"><%= @selected_resume.filename %></dd>
          </div>
          <div>
            <dt class="text-zinc-500 dark:text-zinc-400"><%= t("shared.compose.body") %></dt>
            <dd class="mt-1.5 whitespace-pre-wrap font-mono text-[12px] text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-md p-3 max-h-64 overflow-y-auto dark:text-zinc-300 dark:bg-zinc-800 dark:border-zinc-800"><%= @selected_template.render_content(@application.job) %></dd>
            <% if @selected_template.ai_generated? %>
              <% other_language = @selected_template.language == "bs" ? "en" : "bs" %>
              <%= form_with url: translate_cover_letter_application_path(@application), method: :post, data: { turbo_frame: "_top" }, class: "mt-1.5 flex justify-end" do %>
                <%= hidden_field_tag :template_id, @selected_template.id %>
                <%= hidden_field_tag :resume_blob_id, @selected_resume.blob.id %>
                <%= hidden_field_tag :language, other_language %>
                <%= submit_tag t("shared.ai_cover_letter.translate_to_#{other_language}"), class: "cursor-pointer text-[12px] font-semibold text-zinc-600 hover:text-zinc-950 underline dark:text-zinc-400 dark:hover:text-zinc-50" %>
              <% end %>
            <% end %>
          </div>
        </dl>

        <%= form_with url: dispatch_email_application_path(@application), method: :post, data: { turbo_frame: "_top" }, class: "flex justify-end pt-5 mt-5 border-t border-zinc-100 dark:border-zinc-800" do |f| %>
          <%= hidden_field_tag :template_id, @selected_template.id %>
          <%= hidden_field_tag :resume_blob_id, @selected_resume.blob.id %>
          <%= link_to t("shared.compose.cancel"), crm_path, class: "mr-3 bg-white py-2 px-4 border border-zinc-300 rounded-md text-[13px] font-semibold text-zinc-700 hover:bg-zinc-50 dark:bg-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
          <%= f.submit t(".send_email"), class: "cursor-pointer inline-flex justify-center py-2.5 px-4 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-[13px] text-zinc-400 text-center py-4 dark:text-zinc-600"><%= t("shared.compose.pick_template_and_resume") %></p>
    <% end %>
  </turbo-frame>
</div>
