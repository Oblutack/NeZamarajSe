<!-- app/views/applications/bulk_compose.html.erb -->
<div class="max-w-3xl mx-auto py-8">
  <div class="mb-8">
    <h1 class="text-[26px] font-bold text-zinc-950 tracking-tight mb-1.5 dark:text-zinc-50">Campaign Setup</h1>
    <p class="text-[14px] text-zinc-500 dark:text-zinc-400">You are about to automate applications to <span class="font-semibold text-zinc-900 dark:text-zinc-100"><%= @applications.count %> companies</span>.</p>
  </div>

  <% if Rails.application.config.dry_run_emails %>
    <div class="mb-6 border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 rounded-lg text-[13px] dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-400">
      <span class="font-semibold">Dry-run mode is on.</span> Every email below will actually be delivered to your own inbox (<%= current_user.email %>), not the recipient shown - safe to launch as a test.
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Left Column: The Target List -->
    <div class="bg-zinc-50 rounded-lg p-5 border border-zinc-200 h-fit max-h-96 overflow-y-auto dark:bg-zinc-800 dark:border-zinc-800">
      <h3 class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-3 dark:text-zinc-400">Target Jobs &amp; Recipients</h3>
      <ul class="space-y-2.5">
        <% @applications.each do |app| %>
          <li class="bg-white p-3 rounded-md border border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800">
            <div class="flex items-center justify-between">
              <div class="min-w-0">
                <p class="text-[13px] font-semibold text-zinc-900 truncate dark:text-zinc-100"><%= app.job.title %></p>
                <p class="text-[11.5px] text-zinc-500 dark:text-zinc-400"><%= app.job.company.name %></p>
              </div>
              <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0 ml-2 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <% if app.intended_recipient.present? %>
              <p class="text-[11px] text-zinc-400 mt-1.5 dark:text-zinc-600">To: <%= app.intended_recipient %></p>
            <% else %>
              <p class="text-[11px] text-red-600 font-medium mt-1.5 flex items-center gap-1 dark:text-red-400">
                <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
                No email found<%= " - will be skipped" unless Rails.application.config.dry_run_emails %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Right Column: The Form -->
    <div class="bg-white border border-zinc-200 rounded-lg p-5 dark:bg-zinc-900 dark:border-zinc-800">
      <%= form_with url: bulk_dispatch_applications_path, method: :post, class: "space-y-5" do |f| %>

        <!-- Hidden fields to pass the array of IDs to the dispatch action -->
        <% @applications.each do |app| %>
          <%= f.hidden_field "application_ids[]", value: app.id %>
        <% end %>

        <div>
          <label class="block text-[13px] font-semibold text-zinc-700 mb-1 dark:text-zinc-300">Select Smart Template</label>
          <%= f.collection_select :template_id, @templates, :id, :name, { prompt: "Choose a template..." }, { class: "block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" } %>
          <p class="text-[11.5px] text-zinc-500 mt-1.5 dark:text-zinc-400">Smart tags (e.g. {{company_name}}) will be dynamically injected for each email.</p>
        </div>

        <div>
          <label class="block text-[13px] font-semibold text-zinc-700 mb-1 dark:text-zinc-300">Select Attached Resume</label>
          <%= f.collection_select :resume_blob_id, @resumes, ->(r) { r.blob.id }, ->(r) { r.filename.to_s }, { prompt: "Choose a PDF..." }, { class: "block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" } %>
        </div>

        <div class="pt-5 mt-5 border-t border-zinc-100 flex flex-col gap-2.5 dark:border-zinc-800">
          <%= f.submit "Launch Campaign", class: "cursor-pointer w-full justify-center py-2.5 px-4 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] transition dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
          <%= link_to "Cancel", crm_path, class: "w-full text-center py-2.5 px-4 rounded-md text-[13px] font-semibold text-zinc-600 hover:bg-zinc-50 transition dark:text-zinc-400 dark:hover:bg-zinc-800" %>
        </div>

        <p class="text-[11.5px] text-center text-zinc-400 font-medium dark:text-zinc-600">
          Emails will be staggered by 5 minutes to bypass Google Spam Filters.
        </p>

      <% end %>
    </div>
  </div>
</div>
