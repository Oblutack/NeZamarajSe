<!-- app/views/applications/show.html.erb -->
<div class="max-w-3xl mx-auto py-8">
  <%= link_to "&larr; Back to CRM".html_safe, crm_path, class: "text-[12.5px] font-semibold text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" %>

  <div class="mt-3 mb-6 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight dark:text-zinc-50"><%= @application.job.title %></h1>
      <p class="mt-1.5 text-[13px] text-zinc-500 dark:text-zinc-400">
        <%= link_to @application.job.company.name, company_path(@application.job.company), class: "hover:underline" %>
        &middot; <span class="font-semibold text-zinc-700 dark:text-zinc-300"><%= @application.status.titleize %></span>
      </p>
    </div>

    <% if @application.applied? %>
      <%= link_to "Send follow-up", compose_follow_up_application_path(@application), class: "flex-shrink-0 inline-flex items-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
    <% end %>
  </div>

  <% if @application.needs_follow_up? %>
    <div class="mb-6 border border-amber-200 bg-amber-50 text-amber-800 px-4 py-3 rounded-lg text-[13px] dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-400">
      <span class="font-semibold">No reply in over <%= Rails.application.config.follow_up_after_days %> days.</span> Worth a follow-up.
    </div>
  <% end %>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 mb-6 dark:bg-zinc-900 dark:border-zinc-800">
    <h2 class="text-[13px] font-semibold text-zinc-700 mb-4 dark:text-zinc-300">Details</h2>

    <%= form_with model: @application, url: application_path(@application), method: :patch, class: "grid grid-cols-1 sm:grid-cols-2 gap-4" do |f| %>
      <div>
        <label class="block text-[12px] font-semibold text-zinc-500 mb-1 dark:text-zinc-400">Contact person</label>
        <%= f.text_field :contact_person, placeholder: "e.g. Amila Hodžić", class: "block w-full rounded-md border-zinc-300 text-[13px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border placeholder:text-zinc-400 dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400 dark:placeholder:text-zinc-600" %>
      </div>
      <div>
        <label class="block text-[12px] font-semibold text-zinc-500 mb-1 dark:text-zinc-400">Salary</label>
        <%= f.text_field :salary, placeholder: "e.g. 2500-3000 BAM", class: "block w-full rounded-md border-zinc-300 text-[13px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border placeholder:text-zinc-400 dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400 dark:placeholder:text-zinc-600" %>
      </div>
      <div>
        <label class="block text-[12px] font-semibold text-zinc-500 mb-1 dark:text-zinc-400">Interview date</label>
        <%= f.datetime_field :interview_date, class: "block w-full rounded-md border-zinc-300 text-[13px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
      </div>
      <div>
        <label class="block text-[12px] font-semibold text-zinc-500 mb-1 dark:text-zinc-400">Rejection reason</label>
        <%= f.text_field :rejection_reason, placeholder: "If it didn't work out, why?", class: "block w-full rounded-md border-zinc-300 text-[13px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border placeholder:text-zinc-400 dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400 dark:placeholder:text-zinc-600" %>
      </div>
      <div class="sm:col-span-2 flex justify-end pt-2">
        <%= f.submit "Save details", class: "cursor-pointer inline-flex items-center px-4 py-2 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
    <h2 class="text-[13px] font-semibold text-zinc-700 mb-4 dark:text-zinc-300">Timeline</h2>

    <%= form_with url: add_note_application_path(@application), method: :post, class: "flex gap-2 mb-5" do %>
      <%= text_field_tag :body, nil, placeholder: "Add a note...", class: "flex-1 rounded-md border-zinc-300 text-[13px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border placeholder:text-zinc-400 dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400 dark:placeholder:text-zinc-600" %>
      <button type="submit" class="cursor-pointer inline-flex items-center px-4 py-2 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200">Add</button>
    <% end %>

    <% if @application.application_events.empty? %>
      <p class="text-[13px] text-zinc-400 dark:text-zinc-600">No activity yet.</p>
    <% else %>
      <ul class="space-y-3">
        <% @application.application_events.each do |event| %>
          <li class="text-[13px] flex gap-3">
            <span class="flex-shrink-0 text-zinc-400 text-[11.5px] w-32 pt-0.5 dark:text-zinc-600"><%= event.created_at.strftime("%b %d, %H:%M") %></span>
            <span class="<%= event.event_type == "reply_detected" ? "font-semibold text-emerald-700" : "text-zinc-700" %>">
              <%= application_event_description(event) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
