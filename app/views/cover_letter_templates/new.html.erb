<div class="max-w-2xl mx-auto py-8">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-6 dark:text-zinc-50"><%= t(".title") %></h1>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 mb-5 dark:bg-zinc-900 dark:border-zinc-800">
    <h2 class="text-[13px] font-semibold text-zinc-700 mb-1 dark:text-zinc-300"><%= t(".ai_generate_title") %></h2>
    <p class="text-[12.5px] text-zinc-500 mb-3 dark:text-zinc-400"><%= t(".ai_generate_hint") %></p>

    <% if current_user.resumes.any? %>
      <%= form_with url: generate_cover_letter_templates_path, method: :post, class: "grid grid-cols-1 gap-3 sm:flex sm:flex-wrap sm:items-end" do %>
        <div class="min-w-0">
          <label class="block text-[11.5px] font-medium text-zinc-500 dark:text-zinc-400"><%= t("shared.compose.select_resume") %></label>
          <%= select_tag :resume_blob_id,
                options_for_select(current_user.resumes.map { |r| [ r.filename.to_s, r.blob.id ] }),
                include_blank: t("shared.compose.choose_resume"),
                class: "w-full sm:w-auto mt-1 rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
        </div>
        <div class="min-w-0">
          <label class="block text-[11.5px] font-medium text-zinc-500 dark:text-zinc-400"><%= t("shared.ai_cover_letter.language") %></label>
          <%= select_tag :language, options_for_select(CoverLetterTemplate::LANGUAGES.map { |code, _| [ t("shared.ai_cover_letter.#{code == 'en' ? 'english' : 'bosnian'}"), code ] }, "en"), class: "w-full sm:w-auto mt-1 rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100" %>
        </div>
        <%= button_tag type: "submit", class: "cursor-pointer inline-flex items-center justify-center gap-1.5 px-4 py-2 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" do %>
          <%= render "shared/sparkle_icon", class: "w-3.5 h-3.5" %>
          <%= t("shared.ai_cover_letter.generate") %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-[11.5px] text-amber-700 dark:text-amber-400"><%= t(".no_resumes_yet") %></p>
    <% end %>
  </div>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
    <%= render "form", template: @template %>
  </div>
</div>
