<div class="max-w-4xl mx-auto py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-[22px] font-bold text-zinc-950 tracking-tight dark:text-zinc-50"><%= t(".title") %></h2>
      <p class="mt-1.5 text-[13.5px] text-zinc-500 dark:text-zinc-400"><%= t(".subtitle") %></p>
    </div>
    <%= link_to t(".new_template"), new_cover_letter_template_path, class: "inline-flex items-center justify-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
  </div>

  <% if @templates.any? %>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% @templates.each do |template| %>
        <div class="bg-white rounded-lg border border-zinc-200 flex flex-col hover:border-zinc-300 hover:shadow-sm hover:-translate-y-0.5 transition dark:bg-zinc-900 dark:border-zinc-800 dark:hover:border-zinc-700">
          <div class="px-4 py-4 flex-grow">
            <h3 class="text-[14px] font-semibold text-zinc-900 truncate dark:text-zinc-100" title="<%= template.name %>"><%= template.name %></h3>
            <p class="mt-2 text-[11.5px] text-zinc-500 font-mono line-clamp-4 dark:text-zinc-400"><%= template.body.to_plain_text %></p>
            <% sent = template.sent_count %>
            <p class="mt-3 text-[11.5px] font-medium text-zinc-500 dark:text-zinc-400">
              <% if sent.zero? %>
                <%= t(".not_sent_yet") %>
              <% else %>
                <% replies = template.reply_count %>
                <%= t(".reply_stats", sent: sent, replies: replies, percent: (replies * 100.0 / sent).round) %>
              <% end %>
            </p>
          </div>
          <div class="px-4 py-3 flex justify-between items-center border-t border-zinc-100 dark:border-zinc-800">
            <%= link_to t(".edit"), edit_cover_letter_template_path(template), class: "text-zinc-700 hover:text-zinc-950 text-[12.5px] font-semibold dark:text-zinc-300 dark:hover:text-zinc-50" %>
            <%= button_to t(".delete"), cover_letter_template_path(template), method: :delete, data: { turbo_confirm: t(".delete_confirm") }, class: "cursor-pointer text-zinc-500 hover:text-red-600 text-[12.5px] font-semibold dark:text-zinc-400 dark:hover:text-red-400" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
          icon_path: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
          title: t(".no_templates_yet"),
          description: t(".no_templates_description"),
          cta: link_to(t(".new_template"), new_cover_letter_template_path, class: "inline-flex items-center justify-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200") %>
  <% end %>
</div>
