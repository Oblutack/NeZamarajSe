<!-- app/views/jobs/index.html.erb -->
<div class="relative max-w-7xl mx-auto py-8">
  <%# Fades the page-canvas dot pattern out as it approaches the job
      listings, instead of the header's dots ending in a hard edge right
      above the grid. white, not zinc-50, at the solid end - see the note
      on bg-white in home/index.html.erb for why. The header content below
      needs `relative` (it already has one on the search box, and gets one
      here on the row + grid/empty-state) so it stacks above this: an
      absolutely positioned element paints above non-positioned siblings
      regardless of DOM order, so without that this fade would sit on top
      of the title and search field rather than behind them. %>
  <div class="absolute inset-x-0 top-0 h-52 pointer-events-none bg-[linear-gradient(to_bottom,transparent,white_90%)] dark:bg-[linear-gradient(to_bottom,transparent,var(--color-zinc-950)_90%)]" aria-hidden="true"></div>

  <div class="relative mb-6 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-[22px] font-bold text-zinc-950 tracking-tight dark:text-zinc-50"><%= t(".title") %></h2>
      <p class="mt-1.5 text-[13.5px] text-zinc-500 dark:text-zinc-400">
        <% if @query.present? %>
          <%= t(".showing_results_for") %> <span class="font-semibold text-zinc-900 dark:text-zinc-100">&ldquo;<%= @query %>&rdquo;</span>
        <% elsif current_user.user_preference&.keyword_array&.any? %>
          <%= t(".showing_jobs_matching") %> <span class="font-semibold text-zinc-900 dark:text-zinc-100"><%= current_user.user_preference.keywords %></span>
        <% else %>
          <%= t(".latest_jobs") %>
        <% end %>
        &middot; <%= t("shared.pagination.info", from: @pagy.from, to: @pagy.to, count: @pagy.count) if @pagy.count.positive? %>
      </p>
    </div>
    <%= link_to t(".add_a_job"), new_job_path, class: "flex-shrink-0 inline-flex items-center justify-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
  </div>

  <%= form_with url: jobs_path, method: :get, class: "relative mb-8 bg-white border border-zinc-200 rounded-lg p-4 flex flex-wrap items-end gap-4 dark:bg-zinc-900 dark:border-zinc-800" do %>
    <div class="flex-1 min-w-[200px]">
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".search") %></label>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 dark:text-zinc-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <%= text_field_tag :q, @query, placeholder: t(".search_placeholder"), data: { shortcut: "search" }, class: "w-full pl-9 pr-3 py-2 text-[13px] rounded-md border border-zinc-300 bg-white focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 placeholder:text-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:focus:border-zinc-400 dark:focus:ring-zinc-400 dark:placeholder:text-zinc-600" %>
      </div>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".location") %></label>
      <%= select_tag :location, options_for_select([ [ t(".any"), "" ] ] + @locations.map { |l| [ l, l ] }, params[:location]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".source") %></label>
      <%= select_tag :source, options_for_select([ [ t(".any"), "" ] ] + @sources.map { |s| [ s, s ] }, params[:source]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".posted_within") %></label>
      <%= select_tag :posted_within, options_for_select([ [ t(".any_time"), "" ], [ t(".hours_24"), "1" ], [ t(".days_3"), "3" ], [ t(".days_7"), "7" ], [ t(".days_30"), "30" ] ], params[:posted_within]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".sort_by") %></label>
      <%= select_tag :sort, options_for_select([ [ t(".newest"), "" ], [ t(".deadline"), "deadline" ], [ t(".company"), "company" ] ], params[:sort]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div class="flex items-center gap-4 pb-2">
      <label class="flex items-center gap-1.5 text-[13px] text-zinc-700 cursor-pointer dark:text-zinc-300">
        <%= check_box_tag :has_contact, "1", params[:has_contact] == "1", class: "rounded border-zinc-300 text-zinc-900 focus:ring-zinc-500 dark:border-zinc-700 dark:text-zinc-100 dark:focus:ring-zinc-400" %>
        <%= t(".has_contact_email") %>
      </label>
      <label class="flex items-center gap-1.5 text-[13px] text-zinc-700 cursor-pointer dark:text-zinc-300">
        <%= check_box_tag :expiring_soon, "1", params[:expiring_soon] == "1", class: "rounded border-zinc-300 text-zinc-900 focus:ring-zinc-500 dark:border-zinc-700 dark:text-zinc-100 dark:focus:ring-zinc-400" %>
        <%= t(".expiring_soon") %>
      </label>
    </div>

    <div class="flex gap-2">
      <button type="submit" class="cursor-pointer inline-flex items-center px-4 py-2 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200"><%= t(".filter") %></button>
      <%= link_to t(".clear"), jobs_path, class: "inline-flex items-center px-4 py-2 text-[13px] font-semibold rounded-md text-zinc-600 hover:bg-zinc-50 border border-zinc-200 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:border-zinc-800" %>
    </div>
  <% end %>

  <% if @jobs.empty? %>
    <!-- EMPTY STATE -->
    <div class="relative text-center py-20 bg-white rounded-lg border border-dashed border-zinc-300 dark:bg-zinc-900 dark:border-zinc-700">
      <svg class="mx-auto w-8 h-8 text-zinc-300 dark:text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      <% if @query.present? %>
        <h3 class="mt-4 text-[14.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t(".no_jobs_match_query", query: @query) %></h3>
        <p class="mt-1.5 text-[13px] text-zinc-500 dark:text-zinc-400"><%= t(".try_different_search") %></p>
        <div class="mt-6">
          <%= link_to t(".clear_search"), jobs_path, class: "inline-flex items-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
        </div>
      <% else %>
        <h3 class="mt-4 text-[14.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t(".no_jobs_match_filters") %></h3>
        <p class="mt-1.5 text-[13px] text-zinc-500 dark:text-zinc-400"><%= t(".try_adjusting_filters") %></p>
        <div class="mt-6">
          <%= link_to t(".update_settings"), edit_user_preference_path, class: "inline-flex items-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- JOB GRID -->
    <div class="relative grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% @jobs.each do |job| %>
        <div data-shortcut-item class="bg-white rounded-lg border border-zinc-200 flex flex-col relative hover:border-zinc-300 hover:shadow-sm hover:-translate-y-0.5 transition dark:bg-zinc-900 dark:border-zinc-800 dark:hover:border-zinc-700">

          <!-- AI Data Badges -->
          <div class="absolute top-4 right-4 flex flex-col gap-1 items-end">
            <% if job.hr_email.present? %>
              <span class="inline-flex items-center gap-1 text-[10.5px] font-semibold text-emerald-700 dark:text-emerald-400" title="<%= job.hr_email %>">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/></svg>
                <%= t(".email_found") %>
              </span>
            <% end %>
            <% if job.expires_at.present? %>
              <span class="inline-flex items-center gap-1 text-[10.5px] font-semibold text-red-700 dark:text-red-400">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <%= t(".ends", date: l(job.expires_at, format: "%b %d")) %>
              </span>
            <% end %>
            <% if job.hr_email.blank? && job.expires_at.blank? && job.created_at > 1.hour.ago %>
              <span class="inline-flex items-center gap-1 text-[10.5px] font-semibold text-zinc-400 dark:text-zinc-600">
                <svg class="w-2.5 h-2.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
                <%= t(".analyzing") %>
              </span>
            <% end %>
            <% if @radar_keywords.present? %>
              <span class="inline-flex items-center gap-1 text-[10.5px] font-semibold text-zinc-500 dark:text-zinc-400" title="<%= t(".keyword_match_title", keywords: @radar_keywords.join(", ")) %>">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
                <%= t(".keyword_match", matched: job.keyword_match_count(@radar_keywords), total: @radar_keywords.size) %>
              </span>
            <% end %>
          </div>

          <div class="px-4 py-4 flex-grow pr-28">
            <h3 class="text-[14px] font-semibold text-zinc-900 leading-snug mb-1 dark:text-zinc-100">
              <%= link_to job.title, job_path(job), class: "hover:underline" %>
            </h3>
            <p class="text-[12.5px] text-zinc-500 mb-3 dark:text-zinc-400"><%= job.company.name %></p>

            <div class="text-[11.5px] text-zinc-400 flex items-center gap-1.5 dark:text-zinc-600">
              <span><%= job.location || t(".bosnia_and_herzegovina") %></span>
              <span>&middot;</span>
              <span><%= job.added_by_id.present? ? t(".added_ago", time: time_ago_in_words(job.created_at)) : t(".scraped_ago", time: time_ago_in_words(job.created_at)) %></span>
            </div>

            <% if job.job_sources.size > 1 %>
              <div class="mt-1.5 text-[11px] font-semibold text-zinc-500 flex items-center gap-1 dark:text-zinc-400">
                <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <%= t(".also_posted", count: job.job_sources.size - 1) %>
              </div>
            <% end %>
          </div>

          <div class="px-4 py-3 flex justify-between items-center border-t border-zinc-100 dark:border-zinc-800">
            <% if (safe_url = safe_external_url(job.url)) %>
              <%= link_to t(".view_original"), safe_url, target: "_blank", class: "text-[12px] font-semibold text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" %>
            <% else %>
              <span></span>
            <% end %>

            <% if @saved_job_ids.include?(job.id) %>
              <span class="inline-flex items-center px-2.5 py-1 text-[11.5px] font-semibold rounded text-emerald-700 bg-emerald-50 dark:text-emerald-400 dark:bg-emerald-950/40">
                <%= t(".saved_in_crm") %>
              </span>
            <% else %>
              <%= button_to t(".save_to_wishlist"), applications_path(job_id: job.id), data: { turbo: false }, class: "cursor-pointer inline-flex items-center px-3.5 py-2 text-[11.5px] font-semibold rounded text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
