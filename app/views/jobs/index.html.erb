<!-- app/views/jobs/index.html.erb -->
<div class="max-w-7xl mx-auto py-8">
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="flex-1 min-w-0">
      <h2 class="text-3xl font-extrabold text-gray-900">Job Market</h2>
      <p class="mt-2 text-sm text-gray-500">
        <% if current_user.user_preference&.keyword_array&.any? %>
          Showing jobs matching: <span class="font-bold text-indigo-600"><%= current_user.user_preference.keywords %></span>
        <% else %>
          Latest jobs scraped from Bosnian job boards.
        <% end %>
      </p>
    </div>
  </div>

  <% if @jobs.empty? %>
    <!-- EMPTY STATE -->
    <div class="text-center py-20 bg-white rounded-xl border border-gray-200 border-dashed">
      <span class="text-4xl">📭</span>
      <h3 class="mt-4 text-lg font-bold text-gray-900">No jobs match your radar!</h3>
      <p class="mt-2 text-sm text-gray-500">Try adjusting your keywords in the Radar Settings.</p>
      <div class="mt-6">
        <%= link_to "Update Settings", edit_user_preference_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    </div>
  <% else %>
    <!-- JOB GRID -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @jobs.each do |job| %>
        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-200 flex flex-col transition hover:shadow-md relative">
          
          <!-- AI Data Badges -->
          <div class="absolute top-4 right-4 flex flex-col gap-1 items-end">
            <% if job.hr_email.present? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-800" title="<%= job.hr_email %>">
                ✉️ Email Found
              </span>
            <% end %>
            <% if job.expires_at.present? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-800">
                ⏰ Ends <%= job.expires_at.strftime("%b %d") %>
              </span>
            <% end %>
          </div>

          <div class="px-4 py-5 flex-grow pr-24">
            <h3 class="text-lg font-bold text-gray-900 leading-tight mb-1"><%= job.title %></h3>
            <p class="text-sm font-medium text-indigo-600 mb-4"><%= job.company.name %></p>
            
            <div class="text-xs text-gray-500 flex items-center space-x-2">
              <span>📍 <%= job.location || "Bosnia and Herzegovina" %></span>
              <span>&bull;</span>
              <span>Scraped <%= time_ago_in_words(job.created_at) %> ago</span>
            </div>
          </div>
          
          <div class="bg-gray-50 px-4 py-3 flex justify-between items-center border-t border-gray-200">
            <%= link_to "View Original", job.url, target: "_blank", class: "text-xs font-medium text-gray-500 hover:text-gray-900 underline" %>
            
            <% if @saved_job_ids.include?(job.id) %>
              <span class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded text-green-700 bg-green-100">
                Saved in CRM
              </span>
            <% else %>
              <%= button_to "Save to Wishlist", applications_path(job_id: job.id), class: "inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none cursor-pointer" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>