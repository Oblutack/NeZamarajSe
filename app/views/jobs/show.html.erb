<!-- app/views/jobs/show.html.erb -->
<div class="max-w-3xl mx-auto py-8">
  <%= link_to "&larr; #{t(".back_to_job_market")}".html_safe, jobs_path, class: "text-[12.5px] font-semibold text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" %>

  <div class="mt-3 mb-6 flex items-start justify-between gap-4">
    <div class="flex items-start gap-3">
      <% if @job.company.logo.attached? %>
        <%= image_tag @job.company.logo.variant(resize_to_limit: [ 48, 48 ]), class: "w-12 h-12 rounded-md object-contain border border-zinc-200 bg-white dark:border-zinc-800", alt: @job.company.name %>
      <% end %>
      <div>
        <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight dark:text-zinc-50"><%= @job.title %></h1>
        <p class="mt-1.5 text-[13px] text-zinc-500 dark:text-zinc-400">
          <%= link_to @job.company.name, company_path(@job.company), class: "font-semibold text-zinc-700 hover:underline dark:text-zinc-300" %>
          &middot; <%= @job.location.presence || t(".bosnia_and_herzegovina") %>
        </p>
      </div>
    </div>

    <% if @saved %>
      <span class="flex-shrink-0 inline-flex items-center px-3.5 py-2 text-[12px] font-semibold rounded text-emerald-700 bg-emerald-50 dark:text-emerald-400 dark:bg-emerald-950/40"><%= t(".saved_in_crm") %></span>
    <% else %>
      <%= button_to t(".save_to_wishlist"), applications_path(job_id: @job.id), data: { turbo: false }, class: "cursor-pointer flex-shrink-0 inline-flex items-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6">
    <% if @job.hr_email.present? %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 text-[11.5px] font-semibold rounded bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/></svg>
        <%= @job.hr_email %>
      </span>
    <% end %>
    <% if @job.expires_at.present? %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 text-[11.5px] font-semibold rounded bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <%= t(".deadline", date: l(@job.expires_at, format: "%b %d, %Y")) %>
      </span>
    <% end %>
    <% if @job.employment_type.present? %>
      <span class="inline-flex items-center px-2.5 py-1 text-[11.5px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"><%= t("jobs.new.employment_types.#{@job.employment_type}") %></span>
    <% end %>
    <% if @job.work_mode.present? %>
      <span class="inline-flex items-center px-2.5 py-1 text-[11.5px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"><%= t("jobs.new.work_modes.#{@job.work_mode}") %></span>
    <% end %>
    <% if @job.salary_range.present? %>
      <span class="inline-flex items-center px-2.5 py-1 text-[11.5px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"><%= @job.salary_range %></span>
    <% end %>
    <span class="inline-flex items-center px-2.5 py-1 text-[11.5px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
      <%= @job.added_by_id.present? ? t(".added_ago", time: time_ago_in_words(@job.created_at)) : t(".scraped_ago", time: time_ago_in_words(@job.created_at)) %>
    </span>
    <% if @job.added_by_id.present? %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 text-[11.5px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400" title="<%= t(".private_to_you") %>">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <%= t(".private_to_you") %>
      </span>
    <% end %>
    <% if @radar_keywords.present? %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 text-[11.5px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400" title="<%= t(".keyword_match_title", keywords: @radar_keywords.join(", ")) %>">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
        <%= t(".keyword_match", matched: @job.keyword_match_count(@radar_keywords), total: @radar_keywords.size) %>
      </span>
    <% end %>
  </div>

  <% if @job.hr_email.blank? && @job.company.primary_email.blank? %>
    <%= render "shared/email_suggestion_form", company: @job.company %>
  <% end %>

  <% if @job.job_sources.any? %>
    <div class="mb-6 bg-white border border-zinc-200 rounded-lg p-4 dark:bg-zinc-900 dark:border-zinc-800">
      <p class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-2 dark:text-zinc-400">
        <%= t(".posted_on_boards", count: @job.job_sources.size) %>
      </p>
      <div class="flex flex-wrap gap-2">
        <% @job.job_sources.each do |source| %>
          <span class="inline-flex items-center px-2.5 py-1 text-[11.5px] font-medium rounded border border-zinc-200 text-zinc-600 dark:border-zinc-800 dark:text-zinc-400"><%= source.source_name %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 mb-6 dark:bg-zinc-900 dark:border-zinc-800">
    <h2 class="text-[13px] font-semibold text-zinc-700 mb-3 dark:text-zinc-300"><%= t(".description") %></h2>
    <% if @job.description.present? %>
      <div class="prose prose-sm prose-zinc dark:prose-invert max-w-none text-[13.5px] leading-relaxed">
        <%= sanitize(@job.description, tags: AiJobAnalyzerService::ALLOWED_DESCRIPTION_TAGS, attributes: []) %>
      </div>
    <% else %>
      <p class="text-[13px] text-zinc-400 dark:text-zinc-600"><%= t(".no_description") %></p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-4 mb-6">
    <% if (safe_apply_url = safe_external_url(@job.apply_url)) %>
      <%= link_to t(".apply_now"), safe_apply_url, target: "_blank", class: "cursor-pointer inline-flex items-center gap-1.5 px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
    <% end %>
    <% if (safe_url = safe_external_url(@job.url)) %>
      <%= link_to t(".view_original_posting"), safe_url, target: "_blank", class: "inline-flex items-center gap-1.5 text-[13px] font-semibold text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-zinc-50" %>
    <% end %>
  </div>

  <div class="bg-white border border-zinc-200 rounded-lg p-4 dark:bg-zinc-900 dark:border-zinc-800">
    <h2 class="text-[13px] font-semibold text-zinc-700 mb-2 dark:text-zinc-300"><%= t(".share.title") %></h2>
    <% if @job.shared? %>
      <p class="text-[12px] text-zinc-500 mb-2 dark:text-zinc-400"><%= t(".share.active_hint") %></p>
      <div class="flex flex-wrap items-center gap-2">
        <%= text_field_tag :share_link, public_job_url(@job.share_token), readonly: true, onclick: "this.select()", class: "flex-1 min-w-[220px] rounded-md border-zinc-300 text-[12.5px] p-2 border bg-zinc-50 text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300" %>
        <%= button_to t(".share.unshare"), unshare_job_path(@job), data: { turbo_confirm: t(".share.unshare_confirm") }, class: "cursor-pointer inline-flex items-center px-3.5 py-2 text-[12.5px] font-semibold rounded-md border border-zinc-300 text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
      </div>
    <% else %>
      <p class="text-[12px] text-zinc-500 mb-2 dark:text-zinc-400"><%= t(".share.inactive_hint") %></p>
      <%= button_to t(".share.share"), share_job_path(@job), class: "cursor-pointer inline-flex items-center px-3.5 py-2 text-[12.5px] font-semibold rounded-md border border-zinc-300 text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800" %>
    <% end %>
  </div>
</div>
