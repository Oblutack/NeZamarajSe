<!-- app/views/user_preferences/edit.html.erb -->
<div class="max-w-2xl mx-auto py-8">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-6 dark:text-zinc-50"><%= t(".title") %></h1>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
    <%= form_with model: @preference, url: user_preference_path, method: :patch, class: "space-y-6" do |f| %>

      <div>
        <%= f.label :keywords, t(".job_keywords"), class: "block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300" %>
        <%= f.text_field :keywords, placeholder: t(".keywords_placeholder"), class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
        <p class="text-[12px] text-zinc-500 mt-1.5 dark:text-zinc-400"><%= t(".keywords_hint") %></p>
      </div>

      <div>
        <%= f.label :location, t(".preferred_location"), class: "block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300" %>
        <%= f.text_field :location, placeholder: t(".location_placeholder"), class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
      </div>

      <div class="flex items-start pt-1">
        <div class="flex items-center h-5">
          <%= f.check_box :receive_daily_alerts, class: "focus:ring-zinc-500 h-3.5 w-3.5 text-zinc-900 border-zinc-300 rounded dark:focus:ring-zinc-400 dark:text-zinc-100 dark:border-zinc-700" %>
        </div>
        <div class="ml-2.5 text-[13px]">
          <%= f.label :receive_daily_alerts, t(".enable_daily_radar_email"), class: "font-semibold text-zinc-700 dark:text-zinc-300" %>
          <p class="text-zinc-500 text-[12px] mt-0.5 dark:text-zinc-400"><%= t(".daily_summary_hint") %></p>
        </div>
      </div>

      <div class="flex justify-end pt-4 border-t border-zinc-100 dark:border-zinc-800">
        <%= f.submit t(".save_radar_settings"), class: "cursor-pointer inline-flex justify-center py-2.5 px-4 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
      </div>
    <% end %>
  </div>

  <div class="mt-5 bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800" data-controller="hint">
    <p class="text-[13px] font-semibold text-zinc-700 dark:text-zinc-300"><%= t(".help_tips_title") %></p>
    <p class="text-zinc-500 text-[12px] mt-0.5 dark:text-zinc-400"><%= t("shared.hint.show_tips_again_hint") %></p>
    <div class="mt-3 flex items-center gap-3">
      <button type="button" data-action="click->hint#resetAll" class="cursor-pointer inline-flex justify-center py-2 px-3.5 text-[12.5px] font-semibold rounded-md text-zinc-700 border border-zinc-300 hover:bg-zinc-50 dark:text-zinc-300 dark:border-zinc-700 dark:hover:bg-zinc-800">
        <%= t("shared.hint.show_tips_again") %>
      </button>
      <p hidden data-hint-target="confirmation" class="text-[12px] text-emerald-700 font-medium dark:text-emerald-400"><%= t("shared.hint.reset_confirmation") %></p>
    </div>
  </div>
</div>
