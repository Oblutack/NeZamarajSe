<!-- app/views/user_preferences/edit.html.erb -->
<div class="max-w-2xl mx-auto py-12">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-6">Radar Settings</h1>
  
  <div class="bg-white shadow sm:rounded-lg p-6">
    <%= form_with model: @preference, url: user_preference_path, method: :patch, class: "space-y-6" do |f| %>
      
      <div>
        <%= f.label :keywords, "Job Keywords (Comma separated)", class: "block text-sm font-bold text-gray-700" %>
        <%= f.text_field :keywords, placeholder: "e.g. Ruby, React, Marketing, Manager", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
        <p class="text-xs text-gray-500 mt-1">Our AI and Scraper will only show you jobs matching these words.</p>
      </div>

      <div>
        <%= f.label :location, "Preferred Location", class: "block text-sm font-bold text-gray-700" %>
        <%= f.text_field :location, placeholder: "e.g. Sarajevo, Remote", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
      </div>

      <div class="flex items-start mt-4">
        <div class="flex items-center h-5">
          <%= f.check_box :receive_daily_alerts, class: "focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
        </div>
        <div class="ml-3 text-sm">
          <%= f.label :receive_daily_alerts, "Enable Daily Radar Email", class: "font-medium text-gray-700" %>
          <p class="text-gray-500">Receive a daily summary at 8:00 AM of new jobs matching your keywords.</p>
        </div>
      </div>

      <div class="flex justify-end pt-4 border-t border-gray-200">
        <%= f.submit "Save Radar Settings", class: "cursor-pointer inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>