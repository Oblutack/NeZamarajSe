<!-- app/views/dashboard/show.html.erb -->
<div class="max-w-4xl mx-auto py-8">
  <div class="mb-8">
    <h2 class="text-[22px] font-bold text-zinc-950 tracking-tight">Dashboard</h2>
    <p class="mt-1.5 text-[13.5px] text-zinc-500">Your job hunt, at a glance.</p>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <div class="bg-white border border-zinc-200 rounded-lg p-5">
      <p class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide">Jobs Saved</p>
      <p class="mt-2 text-[32px] font-bold text-zinc-950 tracking-tight"><%= number_with_delimiter(@jobs_saved_count) %></p>
      <p class="mt-1 text-[12.5px] text-zinc-400">Across every column of your CRM</p>
    </div>

    <div class="bg-white border border-zinc-200 rounded-lg p-5">
      <p class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide">Applications Sent This Month</p>
      <p class="mt-2 text-[32px] font-bold text-zinc-950 tracking-tight"><%= number_with_delimiter(@applications_sent_this_month_count) %></p>
      <p class="mt-1 text-[12.5px] text-zinc-400"><%= Time.current.strftime("%B %Y") %></p>
    </div>

    <div class="bg-white border border-zinc-200 rounded-lg p-5">
      <p class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide">Cold vs. Warm Outreach</p>

      <% if (@warm_company_count + @cold_company_count).zero? %>
        <p class="mt-2 text-[13px] text-zinc-400">No company data yet.</p>
      <% else %>
        <div class="mt-3 flex h-2.5 w-full rounded-full overflow-hidden bg-zinc-100">
          <% if @warm_company_count.positive? %>
            <div class="h-full bg-zinc-900" style="width: <%= @warm_company_percent %>%"></div>
          <% end %>
          <% if @warm_company_count.positive? && @cold_company_count.positive? %>
            <div class="h-full w-[2px] bg-white"></div>
          <% end %>
          <% if @cold_company_count.positive? %>
            <div class="h-full bg-zinc-300"></div>
          <% end %>
        </div>

        <div class="mt-3 space-y-1.5">
          <div class="flex items-center justify-between text-[12.5px]">
            <span class="flex items-center gap-1.5 text-zinc-600"><span class="w-2 h-2 rounded-full bg-zinc-900"></span>Warm — posted a job</span>
            <span class="font-semibold text-zinc-900"><%= @warm_company_count %> (<%= @warm_company_percent %>%)</span>
          </div>
          <div class="flex items-center justify-between text-[12.5px]">
            <span class="flex items-center gap-1.5 text-zinc-600"><span class="w-2 h-2 rounded-full bg-zinc-300"></span>Cold — directory only</span>
            <span class="font-semibold text-zinc-900"><%= @cold_company_count %> (<%= @cold_company_percent %>%)</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-5 bg-white border border-zinc-200 rounded-lg p-5">
    <p class="text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-3">Cold Outreach Pipeline</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <%= link_to companies_path(cold: "1", has_email: "0"), class: "block rounded-md border border-zinc-200 p-4 hover:border-zinc-300 hover:bg-zinc-50 transition" do %>
        <p class="text-[24px] font-bold text-zinc-950 tracking-tight"><%= number_with_delimiter(@cold_needs_email_count) %></p>
        <p class="mt-1 text-[12.5px] text-zinc-500">Need an email lookup</p>
      <% end %>
      <%= link_to companies_path(cold: "1", has_email: "1"), class: "block rounded-md border border-zinc-200 p-4 hover:border-zinc-300 hover:bg-zinc-50 transition" do %>
        <p class="text-[24px] font-bold text-emerald-700 tracking-tight"><%= number_with_delimiter(@cold_ready_to_contact_count) %></p>
        <p class="mt-1 text-[12.5px] text-zinc-500">Ready to contact - have an email, never reached out</p>
      <% end %>
      <%= link_to companies_path(cold: "1"), class: "block rounded-md border border-zinc-200 p-4 hover:border-zinc-300 hover:bg-zinc-50 transition" do %>
        <p class="text-[24px] font-bold text-zinc-950 tracking-tight"><%= number_with_delimiter(@cold_contacted_count) %></p>
        <p class="mt-1 text-[12.5px] text-zinc-500">Already contacted</p>
      <% end %>
    </div>
  </div>
</div>
