<div class="mt-6 pt-6 border-t border-zinc-100 space-y-2 text-center text-[12.5px] dark:border-zinc-800">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to t(".log_in"), new_session_path(resource_name), class: "font-semibold text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-zinc-50" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to t(".sign_up"), new_registration_path(resource_name), class: "font-semibold text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-zinc-50" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to t(".forgot_your_password"), new_password_path(resource_name), class: "font-semibold text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to t(".didnt_receive_confirmation_instructions"), new_confirmation_path(resource_name), class: "font-semibold text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to t(".didnt_receive_unlock_instructions"), new_unlock_path(resource_name), class: "font-semibold text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p class="pt-2">
<%# OmniAuth::Utils.camelize turns :google_oauth2 into "GoogleOauth2", which
    is the strategy's name, not a brand a user recognises - fall back to it
    only for a provider we haven't given a display name yet. %>
        <%= button_to t(".sign_in_with", provider: t(".providers.#{provider}", default: OmniAuth::Utils.camelize(provider))), omniauth_authorize_path(resource_name, provider),
              data: { turbo: false },
              class: "cursor-pointer w-full inline-flex justify-center py-2 px-4 border border-zinc-300 text-[13px] font-semibold rounded-md text-zinc-700 bg-white hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:bg-zinc-900 dark:hover:bg-zinc-800" %>
      </p>
    <% end %>
  <% end %>
</div>
