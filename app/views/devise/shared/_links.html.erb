<div class="mt-6 pt-6 border-t border-zinc-100 space-y-2 text-center text-[12.5px]">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to "Log in", new_session_path(resource_name), class: "font-semibold text-zinc-700 hover:text-zinc-950" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to "Sign up", new_registration_path(resource_name), class: "font-semibold text-zinc-700 hover:text-zinc-950" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-semibold text-zinc-500 hover:text-zinc-800" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: "font-semibold text-zinc-500 hover:text-zinc-800" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: "font-semibold text-zinc-500 hover:text-zinc-800" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p class="pt-2">
        <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider),
              data: { turbo: false },
              class: "cursor-pointer w-full inline-flex justify-center py-2 px-4 border border-zinc-300 text-[13px] font-semibold rounded-md text-zinc-700 bg-white hover:bg-zinc-50" %>
      </p>
    <% end %>
  <% end %>
</div>
