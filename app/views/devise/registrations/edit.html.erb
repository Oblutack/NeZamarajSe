<div class="max-w-md mx-auto py-10">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-6 text-center">Edit <%= resource_name.to_s.humanize %></h1>

  <div class="bg-white border border-zinc-200 rounded-lg p-6">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-[13px] font-semibold text-zinc-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-[11.5px] text-zinc-500">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
      <% end %>

      <div>
        <%= f.label :password, class: "block text-[13px] font-semibold text-zinc-700" %>
        <p class="text-[11.5px] text-zinc-500 mt-1">
          Leave blank if you don't want to change it
          <% if @minimum_password_length %>
            (<%= @minimum_password_length %> characters minimum)
          <% end %>
        </p>
        <%= f.password_field :password, autocomplete: "new-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-[13px] font-semibold text-zinc-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-[13px] font-semibold text-zinc-700" %>
        <p class="text-[11.5px] text-zinc-500 mt-1">We need your current password to confirm your changes</p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <div class="flex justify-end pt-4 border-t border-zinc-100">
        <%= f.submit "Update", class: "cursor-pointer inline-flex justify-center py-2 px-4 text-[13px] font-semibold rounded-md text-white bg-indigo-700 hover:bg-indigo-800 active:scale-[0.98]" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 bg-white border border-zinc-200 rounded-lg p-6">
    <h3 class="text-[13px] font-semibold text-zinc-700">Cancel my account</h3>
    <p class="text-[12.5px] text-zinc-500 mt-1">Unhappy? You can cancel your account at any time.</p>
    <div class="mt-3">
      <%= button_to "Cancel my account", registration_path(resource_name),
            data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
            method: :delete,
            class: "cursor-pointer inline-flex justify-center py-2 px-4 text-[13px] font-semibold rounded-md text-white bg-red-600 hover:bg-red-700" %>
    </div>
  </div>

  <p class="mt-6 text-center text-[12.5px]">
    <%= link_to "Back", :back, class: "font-semibold text-indigo-700 hover:text-indigo-900" %>
  </p>
</div>
