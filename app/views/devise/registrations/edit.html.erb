<div class="max-w-md mx-auto py-10">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-6 text-center dark:text-zinc-50"><%= t(".title") %></h1>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-[11.5px] text-zinc-500 dark:text-zinc-400"><%= t(".waiting_confirmation_for", email: resource.unconfirmed_email) %></p>
      <% end %>

      <div>
        <%= f.label :password, class: "block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300" %>
        <p class="text-[11.5px] text-zinc-500 mt-1 dark:text-zinc-400">
          <%= t(".leave_blank_if_you_dont_want_to_change_it") %>
          <% if @minimum_password_length %>
            (<%= t(".characters_minimum", count: @minimum_password_length) %>)
          <% end %>
        </p>
        <%= f.password_field :password, autocomplete: "new-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
      </div>

      <div>
        <%= f.label :current_password, class: "block text-[13px] font-semibold text-zinc-700 dark:text-zinc-300" %>
        <p class="text-[11.5px] text-zinc-500 mt-1 dark:text-zinc-400"><%= t(".need_current_password") %></p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 p-2 border dark:border-zinc-700 dark:focus:border-zinc-400 dark:focus:ring-zinc-400" %>
      </div>

      <div class="flex justify-end pt-4 border-t border-zinc-100 dark:border-zinc-800">
        <%= f.submit t(".update"), class: "cursor-pointer inline-flex justify-center py-2.5 px-4 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 bg-white border border-zinc-200 rounded-lg p-6 dark:bg-zinc-900 dark:border-zinc-800">
    <h3 class="text-[13px] font-semibold text-zinc-700 dark:text-zinc-300"><%= t(".cancel_my_account") %></h3>
    <p class="text-[12.5px] text-zinc-500 mt-1 dark:text-zinc-400"><%= t(".unhappy_notice") %></p>
    <div class="mt-3">
      <%= button_to t(".cancel_my_account"), registration_path(resource_name),
            data: { confirm: t(".are_you_sure"), turbo_confirm: t(".are_you_sure") },
            method: :delete,
            class: "cursor-pointer inline-flex justify-center py-2 px-4 text-[13px] font-semibold rounded-md text-white bg-red-600 hover:bg-red-700 dark:text-zinc-900" %>
    </div>
  </div>

  <p class="mt-6 text-center text-[12.5px]">
    <%= link_to t(".back"), :back, class: "font-semibold text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-zinc-50" %>
  </p>
</div>
