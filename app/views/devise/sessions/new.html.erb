<div class="max-w-md mx-auto py-10">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-6 text-center">Log in</h1>

  <div class="bg-white border border-zinc-200 rounded-lg p-6">
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-[13px] font-semibold text-zinc-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-[13px] font-semibold text-zinc-700" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "focus:ring-indigo-500 h-3.5 w-3.5 text-indigo-700 border-zinc-300 rounded" %>
          <%= f.label :remember_me, class: "ml-2 text-[12.5px] text-zinc-700" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Log in", class: "cursor-pointer w-full inline-flex justify-center py-2 px-4 text-[13px] font-semibold rounded-md text-white bg-indigo-700 hover:bg-indigo-800" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
