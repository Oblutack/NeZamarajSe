<div class="max-w-md mx-auto py-12">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-6 text-center">Change your password</h1>

  <div class="bg-white shadow sm:rounded-lg p-6">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "New password", class: "block text-sm font-bold text-gray-700" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-bold text-gray-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" %>
      </div>

      <div>
        <%= f.submit "Change my password", class: "cursor-pointer w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
