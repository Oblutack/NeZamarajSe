<div class="max-w-md mx-auto py-10">
  <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight mb-6 text-center">Change your password</h1>

  <div class="bg-white border border-zinc-200 rounded-lg p-6">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "New password", class: "block text-[13px] font-semibold text-zinc-700" %>
        <% if @minimum_password_length %>
          <p class="text-[11.5px] text-zinc-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-[13px] font-semibold text-zinc-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1.5 block w-full rounded-md border-zinc-300 text-[13.5px] focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 p-2 border" %>
      </div>

      <div>
        <%= f.submit "Change my password", class: "cursor-pointer w-full inline-flex justify-center py-2 px-4 text-[13px] font-semibold rounded-md text-white bg-indigo-700 hover:bg-indigo-800" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
