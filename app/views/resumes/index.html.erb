<!-- app/views/resumes/index.html.erb -->
<div class="max-w-4xl mx-auto py-8">
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="flex-1 min-w-0">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl sm:truncate">
        Asset Library
      </h2>
      <p class="mt-2 text-sm text-gray-500">Manage your CVs and Cover Letters to use in automated campaigns.</p>
    </div>
  </div>

  <!-- Upload Form -->
  <div class="bg-white shadow sm:rounded-lg mb-8">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Upload new Resume</h3>
      <div class="mt-2 max-w-xl text-sm text-gray-500">
        <p>Please upload your CV in PDF format. We will use this to apply to jobs on your behalf.</p>
      </div>
      
      <!-- Rails Form Builder -->
      <%= form_with url: resumes_path, local: true, html: { multipart: true, class: "mt-5 sm:flex sm:items-center" } do |form| %>
        <div class="w-full sm:max-w-xs">
          <%= form.file_field :resume, accept: 'application/pdf', class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
        </div>
        <%= form.submit "Upload", class: "mt-3 w-full inline-flex items-center justify-center px-4 py-2 border border-transparent shadow-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- List of Uploaded Resumes -->
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul role="list" class="divide-y divide-gray-200">
      <% if @resumes.any? %>
        <% @resumes.each do |resume| %>
          <li>
            <div class="px-4 py-4 flex items-center sm:px-6 justify-between">
              <div class="flex items-center">
                <svg class="flex-shrink-0 h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
                <div class="ml-3">
                  <!-- url_for generates a temporary URL to view the file -->
                  <%= link_to resume.filename, url_for(resume), target: "_blank", class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
                  <p class="text-xs text-gray-500 mt-1">Uploaded <%= time_ago_in_words(resume.created_at) %> ago &middot; <%= (resume.byte_size / 1024.0).round(2) %> KB</p>
                </div>
              </div>
              
              <!-- Delete Button -->
              <%= button_to "Delete", resume_path(resume), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this CV?" }, class: "text-sm text-red-600 hover:text-red-900 font-medium" %>
            </div>
          </li>
        <% end %>
      <% else %>
        <li class="px-4 py-8 text-center text-sm text-gray-500">
          No resumes uploaded yet.
        </li>
      <% end %>
    </ul>
  </div>
</div>