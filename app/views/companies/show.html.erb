<!-- app/views/companies/show.html.erb -->
<div class="max-w-3xl mx-auto py-8">
  <%= link_to "&larr; All Companies".html_safe, companies_path, class: "text-[12.5px] font-semibold text-zinc-500 hover:text-zinc-900" %>

  <div class="mt-3 mb-8 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-[22px] font-bold text-zinc-950 tracking-tight"><%= @company.name %></h1>
      <p class="mt-1.5 text-[13px] text-zinc-500">
        <% if @company.is_cold_outreach %>
          <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-100 text-zinc-600">Cold outreach target</span>
        <% else %>
          <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-900 text-white">Warm - posted a job</span>
        <% end %>
        <% if @company.industry_code.present? %>
          <span class="ml-1.5 text-zinc-400">NACE <%= @company.industry_code %></span>
        <% end %>
      </p>
    </div>

    <%= link_to "Send outreach email", compose_outreach_company_path(@company), class: "flex-shrink-0 inline-flex items-center px-4 py-2.5 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98]" %>
  </div>

  <div class="bg-white border border-zinc-200 rounded-lg p-6 mb-6">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-[13px]">
      <div>
        <dt class="text-zinc-500">Contact email</dt>
        <% if @company.primary_email.present? %>
          <dd class="font-medium text-emerald-700 mt-0.5"><%= @company.primary_email %></dd>
        <% else %>
          <dd class="mt-0.5">
            <span class="text-red-600 font-medium">Not found yet</span>
            <%= button_to "Find email", refresh_email_company_path(@company), class: "cursor-pointer ml-2 inline-flex items-center px-2.5 py-1 text-[11.5px] font-semibold rounded text-zinc-700 bg-zinc-100 hover:bg-zinc-200" %>
          </dd>
        <% end %>
      </div>
      <div>
        <dt class="text-zinc-500">Website</dt>
        <dd class="font-medium text-zinc-900 mt-0.5">
          <% if (safe_url = safe_external_url(@company.website)) %>
            <%= link_to @company.website, safe_url, target: "_blank", class: "text-zinc-900 hover:underline" %>
          <% else %>
            <span class="text-zinc-400">&mdash;</span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-zinc-500">Address</dt>
        <dd class="font-medium text-zinc-900 mt-0.5"><%= @company.address.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-zinc-500">Last contacted</dt>
        <dd class="font-medium text-zinc-900 mt-0.5">
          <% if @company.last_contacted_at %>
            <%= time_ago_in_words(@company.last_contacted_at) %> ago
            <% if @company.last_contacted_by %> by <%= @company.last_contacted_by.email %><% end %>
          <% else %>
            <span class="text-zinc-400">Never</span>
          <% end %>
        </dd>
      </div>
    </dl>

    <% if @company.primary_email.present? %>
      <%= button_to "Re-run email lookup", refresh_email_company_path(@company), class: "cursor-pointer mt-4 inline-flex items-center px-3 py-1.5 text-[11.5px] font-semibold rounded text-zinc-500 hover:bg-zinc-50 border border-zinc-200" %>
    <% end %>
  </div>

  <div class="bg-white border border-zinc-200 rounded-lg p-6">
    <h2 class="text-[13px] font-semibold text-zinc-700 mb-3">Jobs posted (<%= @jobs.count %>)</h2>

    <% if @jobs.empty? %>
      <p class="text-[13px] text-zinc-400">No job postings from this company yet - it was found via directory outreach.</p>
    <% else %>
      <ul class="divide-y divide-zinc-100">
        <% @jobs.each do |job| %>
          <li class="py-2.5 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <% if (safe_url = safe_external_url(job.url)) %>
                <%= link_to job.title, safe_url, target: "_blank", class: "text-[13px] font-medium text-zinc-900 hover:underline truncate" %>
              <% else %>
                <span class="text-[13px] font-medium text-zinc-900 truncate"><%= job.title %></span>
              <% end %>
              <p class="text-[11.5px] text-zinc-400"><%= job.location || "Bosnia and Herzegovina" %> &middot; Scraped <%= time_ago_in_words(job.created_at) %> ago</p>
            </div>
            <% if job.hr_email.present? %>
              <span class="flex-shrink-0 text-[11px] font-semibold text-emerald-700">Email found</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
