<!-- app/views/companies/index.html.erb -->
<div class="max-w-7xl mx-auto py-8">
  <div class="mb-8">
    <h2 class="text-[22px] font-bold text-zinc-950 tracking-tight dark:text-zinc-50"><%= t(".title") %></h2>
    <p class="mt-1.5 text-[13.5px] text-zinc-500 dark:text-zinc-400"><%= t(".subtitle") %> <span class="font-semibold text-zinc-900 dark:text-zinc-100"><%= @pagy.count %></span> <%= t(".total") %></p>
  </div>

  <%= form_with url: companies_path, method: :get, class: "mb-6 bg-white border border-zinc-200 rounded-lg p-4 flex flex-wrap items-end gap-4 dark:bg-zinc-900 dark:border-zinc-800" do %>
    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".email") %></label>
      <%= select_tag :has_email, options_for_select([ [ t(".any"), "" ], [ t(".has_email"), "1" ], [ t(".no_email"), "0" ] ], params[:has_email]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".outreach_type") %></label>
      <%= select_tag :cold, options_for_select([ [ t(".any"), "" ], [ t(".warm_option"), "0" ], [ t(".cold_option"), "1" ] ], params[:cold]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".industry_code") %></label>
      <%= select_tag :industry_code, options_for_select([ [ t(".any"), "" ] ] + @industry_codes.map { |c| [ c, c ] }, params[:industry_code]),
            class: "rounded-md border-zinc-300 text-[13px] p-2 border dark:border-zinc-700" %>
    </div>

    <div>
      <label class="block text-[11px] font-bold text-zinc-500 uppercase tracking-wide mb-1 dark:text-zinc-400"><%= t(".city") %></label>
      <%= text_field_tag :city, params[:city], placeholder: t(".city_placeholder"), data: { shortcut: "search" }, class: "rounded-md border-zinc-300 text-[13px] p-2 border placeholder:text-zinc-400 dark:border-zinc-700 dark:placeholder:text-zinc-600" %>
    </div>

    <div class="flex gap-2">
      <button type="submit" class="cursor-pointer inline-flex items-center px-4 py-2 text-[13px] font-semibold rounded-md text-white bg-zinc-900 hover:bg-zinc-800 active:scale-[0.98] dark:text-zinc-900 dark:bg-white dark:hover:bg-zinc-200"><%= t(".filter") %></button>
      <%= link_to t(".clear"), companies_path, class: "inline-flex items-center px-4 py-2 text-[13px] font-semibold rounded-md text-zinc-600 hover:bg-zinc-50 border border-zinc-200 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:border-zinc-800" %>
    </div>
  <% end %>

  <% if @companies.empty? %>
    <div class="text-center py-20 bg-white rounded-lg border border-dashed border-zinc-300 dark:bg-zinc-900 dark:border-zinc-700">
      <h3 class="text-[14.5px] font-semibold text-zinc-900 dark:text-zinc-100"><%= t(".no_companies_match") %></h3>
      <p class="mt-1.5 text-[13px] text-zinc-500 dark:text-zinc-400"><%= t(".try_loosening") %></p>
    </div>
  <% else %>
    <%# Below `sm`, a stacked card list instead of the table - same data,
        same treatment the CRM board got in Track F (a wide table with
        several columns is unreadable squeezed onto a phone, and horizontal
        scrolling a data table is a poor substitute). %>
    <div class="sm:hidden bg-white border border-zinc-200 rounded-lg divide-y divide-zinc-100 overflow-hidden dark:bg-zinc-900 dark:border-zinc-800 dark:divide-zinc-800">
      <% @companies.each do |company| %>
        <div data-shortcut-item class="p-4 space-y-2">
          <div class="flex items-start justify-between gap-2">
            <%= link_to company.name, company_path(company), class: "font-semibold text-zinc-900 hover:underline dark:text-zinc-100" %>
            <% if company.is_cold_outreach %>
              <span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"><%= t(".cold") %></span>
            <% else %>
              <span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"><%= t(".warm") %></span>
            <% end %>
          </div>
          <div class="flex items-center justify-between text-[12px] text-zinc-500 dark:text-zinc-400">
            <span><%= t(".jobs") %>: <%= company.jobs_count %></span>
            <span><%= company.last_contacted_at ? t(".ago", time: time_ago_in_words(company.last_contacted_at)) : t(".never") %></span>
          </div>
          <% if company.primary_email.present? %>
            <p class="text-[12px] text-emerald-700 font-medium dark:text-emerald-400"><%= company.primary_email %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="hidden sm:block bg-white border border-zinc-200 rounded-lg overflow-hidden dark:bg-zinc-900 dark:border-zinc-800">
      <div class="overflow-x-auto">
        <table class="w-full text-[13px]">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-800">
              <th class="text-left font-semibold text-zinc-500 uppercase text-[11px] tracking-wide px-4 py-2.5 dark:text-zinc-400"><%= t(".name") %></th>
              <th class="text-left font-semibold text-zinc-500 uppercase text-[11px] tracking-wide px-4 py-2.5 dark:text-zinc-400"><%= t(".type") %></th>
              <th class="text-left font-semibold text-zinc-500 uppercase text-[11px] tracking-wide px-4 py-2.5 dark:text-zinc-400"><%= t(".jobs") %></th>
              <th class="text-left font-semibold text-zinc-500 uppercase text-[11px] tracking-wide px-4 py-2.5 dark:text-zinc-400"><%= t(".contact_email") %></th>
              <th class="text-left font-semibold text-zinc-500 uppercase text-[11px] tracking-wide px-4 py-2.5 dark:text-zinc-400"><%= t(".last_contacted") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            <% @companies.each do |company| %>
              <tr data-shortcut-item class="hover:bg-zinc-50 dark:hover:bg-zinc-800">
                <td class="px-4 py-2.5">
                  <%= link_to company.name, company_path(company), class: "font-semibold text-zinc-900 hover:underline dark:text-zinc-100" %>
                </td>
                <td class="px-4 py-2.5">
                  <% if company.is_cold_outreach %>
                    <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"><%= t(".cold") %></span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"><%= t(".warm") %></span>
                  <% end %>
                </td>
                <td class="px-4 py-2.5 text-zinc-600 dark:text-zinc-400"><%= company.jobs_count %></td>
                <td class="px-4 py-2.5">
                  <% if company.primary_email.present? %>
                    <span class="text-emerald-700 font-medium dark:text-emerald-400"><%= company.primary_email %></span>
                  <% else %>
                    <span class="text-zinc-400 dark:text-zinc-600">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-4 py-2.5 text-zinc-500 dark:text-zinc-400">
                  <%= company.last_contacted_at ? t(".ago", time: time_ago_in_words(company.last_contacted_at)) : t(".never") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
